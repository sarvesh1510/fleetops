# ─────────────────────────────────────────────────────────────────────────────
# FleetOps India — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=FleetOps
ENVIRONMENT=development          # development | staging | production
DEBUG=false

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_32_CHAR_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── Database ──────────────────────────────────────────────────────────────────
# Local:        mongodb://localhost:27017
# Atlas:        mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
#
# MongoDB Atlas (free tier):
#   1. Sign up at https://cloud.mongodb.com
#   2. Create a free M0 cluster (512 MB, shared)
#   3. Create a database user with readWrite role
#   4. Add your IP to the network access list (or 0.0.0.0/0 for dev)
#   5. Click Connect → Drivers → Python → copy URI
#
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=fleetops

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Simulation ────────────────────────────────────────────────────────────────
# Multiplier on simulation tick speed. 1 = realtime, 5 = 5x faster
SIMULATION_SPEED=1.0
SIMULATION_INTERVAL_SECONDS=2.0
# Persist telemetry every N ticks (reduces MongoDB writes)
TELEMETRY_PERSIST_INTERVAL=10

# ── Optimization ──────────────────────────────────────────────────────────────
# How often (seconds) the scheduled optimization loop runs
OPTIMIZATION_INTERVAL_SECONDS=30
# Minimum improvement % to apply an optimization result (0.05 = 5%)
OPTIMIZATION_IMPROVEMENT_THRESHOLD=0.05

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# These go in frontend/.env (not backend .env)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws/fleet

# ── Optional: Mapbox (for premium map tiles) ──────────────────────────────────
# The platform uses OpenStreetMap/Leaflet by default (no key required).
# To use Mapbox GL JS instead:
#   1. Sign up at https://account.mapbox.com
#   2. Create a token with styles:tiles scope
#   3. Free tier: 50,000 map loads/month (as of 2024 — verify at mapbox.com/pricing)
MAPBOX_TOKEN=
